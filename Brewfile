# Brewfile — install with `brew bundle`

# Core tools
brew "mise"           # Runtime version manager (Ruby, Node.js, Python, etc.)
brew "neovim"         # Text editor
brew "tmux"           # Terminal multiplexer
brew "fzf"            # Fuzzy finder
brew "ripgrep"        # Fast grep (used by Neovim pickers)
brew "direnv"         # Per-directory environment variables
brew "git-lfs"        # Git Large File Storage

# Git
brew "git-delta"      # Syntax-highlighted git diffs
brew "git-absorb"     # Automatic fixup commits

# Shell
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "zoxide"         # Smarter cd

# Languages & runtimes
brew "node@24"
brew "postgresql@16"

# Fonts
cask "font-fira-code-nerd-font"

# Apps
cask "ghostty"        # Terminal emulator
cask "1password"      # Password manager & SSH agent
